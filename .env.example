LINEAR_API_KEY=
LANGFUSE_ENCODED_TOKEN=
AZURE_DEVOPS_PAT=

# Web app login, "name:hash" pairs separated by commas. Make a hash with:
#   uv run python -c "from werkzeug.security import generate_password_hash as h; import getpass; print(h(getpass.getpass()))"
# Keep the single quotes: hashes contain "$".
SF_USERS='akash:scrypt:...'
# Signs the session cookie that holds the CSRF token. Make one with:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Optional: where issue state (factory.db) and artifacts live. Defaults to ./bug_workspace,
# resolved once at startup so the worker and the web app share it.
SF_WORKSPACE_DIR=

# Optional: PEM file with the proxy's CA, where the system cert store doesn't have it
# (e.g. WSL or a container). On Windows the system store already trusts it.
SF_CA_BUNDLE=

# Everything below is optional; the defaults are shown. See src/software_factory/config.py.

# The repo the factory fixes, where its worktrees go, and the branch fixes start from
# SF_TARGET_REPO=C:/Users/ar14152/code/cpc-agentic-workplace-platform
# SF_WORKTREE_DIR=<SF_TARGET_REPO>/.claude/worktrees
# SF_BASE_BRANCH=dev
# SF_LANGFUSE_URL=http://10.60.227.122:3000
# SF_ADO_REPO_URL=... and SF_ADO_REPO_API=... for the Azure DevOps repo behind origin

# Models per phase
# SF_PLAN_MODEL=opus
# SF_IMPLEMENT_MODEL=sonnet
# SF_REVIEW_MODEL=sonnet

# Worker: runs at once, seconds between Linear polls and merge checks, and how many times
# a rate-limited run goes back on the queue before it needs attention
# SF_MAX_CONCURRENT_RUNS=2
# SF_INGEST_SECONDS=300
# SF_MERGE_POLL_SECONDS=600
# SF_MAX_ATTEMPTS=3

# The web app's address, for the plan link in PR descriptions (no link when unset)
# SF_PUBLIC_URL=http://localhost:5000

# Linear: which issues to pick up, the states to move them to, and 0 to never write back
# SF_LINEAR_TODO_STATE=Todo
# SF_LINEAR_BUG_LABEL=Bug
# SF_LINEAR_IN_PROGRESS_STATE=In Progress
# SF_LINEAR_MERGED_STATE=In Review
# SF_LINEAR_WRITEBACK=1

# Per-issue slots: slot n gets API port BASE+n, web port BASE+n and Redis DB n+1
# SF_SLOT_COUNT=14
# SF_SLOT_API_PORT_BASE=8100
# SF_SLOT_WEB_PORT_BASE=4300
