LINEAR_API_KEY=
LANGFUSE_ENCODED_TOKEN=
AZURE_DEVOPS_PAT=

# Web app login, "name:hash" pairs separated by commas. Make a hash with:
#   uv run python -c "from werkzeug.security import generate_password_hash as h; import getpass; print(h(getpass.getpass()))"
# Keep the single quotes: hashes contain "$".
SF_USERS='akash:scrypt:...'
# Signs the session cookie that holds the CSRF token. Make one with:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Optional: where issue state (factory.db) and artifacts live. Defaults to ./bug_workspace,
# resolved once at startup so the CLI and the web app share it.
SF_WORKSPACE_DIR=

# Optional: PEM file with the proxy's CA, where the system cert store doesn't have it
# (e.g. WSL or a container). On Windows the system store already trusts it.
SF_CA_BUNDLE=
